# Copy to .env and adjust:  cp .env.example .env
# Docker Compose reads .env automatically; every value is optional.

# Address and port on the host where Bookshelf is reachable.
# Use 127.0.0.1 to only allow local access (e.g. behind a reverse proxy on the same host).
BOOKSHELF_BIND_IP=0.0.0.0
BOOKSHELF_HOST_PORT=8080

# Allow KOReader devices to create accounts via "Register" in the sync settings.
BOOKSHELF_ALLOW_REGISTRATION=false

# Maximum size of a single upload in MB.
BOOKSHELF_MAX_UPLOAD_MB=200

# How long a web login lasts, in days.
BOOKSHELF_SESSION_DAYS=30

# Set to true when Bookshelf is served over HTTPS (e.g. behind a reverse proxy).
BOOKSHELF_SECURE_COOKIES=false

# Shared library folder for all users, e.g. a NAS share (empty = every user gets their own
# folder, books/<user id>/ in the data directory). Either way books are stored as
# Author/Series/Title.ext, and files you copy into a library folder are added by a scan.
BOOKSHELF_INGEST_DIR=

# Names that library scans skip, as comma-separated patterns (e.g. @eaDir,*.tmp). Files and
# folders starting with "." (like Syncthing's .stfolder) are always skipped.
BOOKSHELF_SCAN_IGNORE=

# Time zone used to group reading statistics by day.
TZ=UTC
