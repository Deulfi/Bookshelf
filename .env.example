# Copy to .env and adjust:  cp .env.example .env
# Docker Compose reads .env automatically; every value is optional.

# Address and port on the host where Bookshelf is reachable.
# Use 127.0.0.1 to only allow local access (e.g. behind a reverse proxy on the same host).
BOOKSHELF_BIND_IP=0.0.0.0
BOOKSHELF_HOST_PORT=8080

# Allow KOReader devices to create accounts via "Register" in the sync settings.
BOOKSHELF_ALLOW_REGISTRATION=false

# Maximum size of a single upload in MB.
BOOKSHELF_MAX_UPLOAD_MB=200

# How long a web login lasts, in days.
BOOKSHELF_SESSION_DAYS=30

# Set to true when Bookshelf is served over HTTPS (e.g. behind a reverse proxy).
BOOKSHELF_SECURE_COOKIES=false

# Shared library folder for all users, e.g. a NAS share (empty = every user gets their own
# folder, books/<user id>/ in the data directory). Either way uploads get a folder per book,
# Author/Series/Vol 1 - Title/Title.ext, and files you copy into a library folder are added by
# a scan.
BOOKSHELF_INGEST_DIR=

# Names that library scans skip, as comma-separated patterns (e.g. @eaDir,*.tmp). Files and
# folders starting with "." (like Syncthing's .stfolder) are always skipped. Administrators can
# add more under Settings -> Library folders.
BOOKSHELF_SCAN_IGNORE=

# How the web UI signs people in (see "Signing in" in the README):
#   password  login page (default)
#   none      single user, no login: only on a home network or behind a proxy with a login
#   header    a reverse proxy (Authelia, Authentik, oauth2-proxy, ...) signs people in and sends
#             the username in BOOKSHELF_AUTH_HEADER, from an address in BOOKSHELF_AUTH_PROXIES
# KOReader, OPDS and WebDAV always use the account password (Settings -> Device password).
BOOKSHELF_AUTH=password
BOOKSHELF_AUTH_HEADER=Remote-User
BOOKSHELF_AUTH_PROXIES=

# Web novels (optional): a remote lncrawl server (lightnovel-crawler >= 4.x, run with
# "lncrawl server") that fetches novels as EPUBs. Leave BOOKSHELF_LNCRAWL_URL empty to hide
# the Web novels tab. Create an API token in lncrawl's web UI (Account -> API tokens).
# Set BOOKSHELF_LNCRAWL_VERIFY_TLS=false for a self-signed certificate on your own network.
BOOKSHELF_LNCRAWL_URL=
BOOKSHELF_LNCRAWL_TOKEN=
BOOKSHELF_LNCRAWL_VERIFY_TLS=true

# Time zone used to group reading statistics by day.
TZ=UTC
